{
  "lines": [
    { "id": "greet", "text": "무슨 일이오?" },
    { "id": "greet", "text": "어서 오시오. 뭘 알고 싶소?" },
    { "id": "greet", "text": "그래, 무슨 일로 왔소?" },

    { "id": "testimony.seen", "text": "{when} {area}에서 웬 {actor:이} {verb} 걸 봤소." },
    { "id": "testimony.seen", "text": "{when} {area}에서 웬 {actor:이} {verb} 걸 봤는디, 영 꺼림칙하더구먼." },
    { "id": "testimony.heard", "text": "{source}한테 들었는디, {when} {area}에서 웬 {actor:이} {verb} 걸 봤다더구먼." },
    { "id": "testimony.rumor", "text": "누가 그러는디, {area}에서 {actor:이} {verb} 걸 봤다는 소문이 있소." },

    { "id": "trace.seen", "text": "{when} {area}에서 {object:을} 봤소. 아이고, 끔찍하더구먼." },
    { "id": "trace.heard", "text": "{source}한테 들었는디, {area}에 {object:이} 있다더구먼." },
    { "id": "trace.rumor", "text": "{area}에 {object:이} 있다는 소문이 돌더구먼." },
    { "id": "sleep", "text": "Z... zzz..." },
    { "id": "sleep", "text": "드르렁… 쿨…" },
    { "id": "sleep", "text": "음냐… 내일 해도 되는디… zzz" },
    { "id": "sleep", "text": "으음… 누구여… zzz" },
    { "id": "greet.home", "text": "이 늦은 시간에 무슨 일이오?" },
    { "id": "greet.home", "text": "날도 저물었는디, 무슨 일이시오?" },
    { "id": "greet.home", "text": "막 들어가 쉬려던 참이오. 무슨 일이오?" },
    { "id": "ghost.seen", "text": "{when} 밤에 {area}에서 귀신을 봤소. 아직도 등골이 서늘하오." },
    { "id": "ghost.seen", "text": "{when} 밤 {area} 쪽에서 허연 것이 떠다니는 걸 봤소. 귀신이 틀림없소." },
    { "id": "ghost.heard", "text": "{source}한테 들었는디, {when} 밤에 {area}에서 귀신을 봤다더구먼." },
    { "id": "ghost.rumor", "text": "{area}에 밤마다 귀신이 나온다는 소문이 돌더구먼." },

    { "id": "absent.seen", "text": "{actor:이} 어제 하루 종일 안 보였소. 무슨 일이 있는 건 아닌지…" },
    { "id": "absent.heard", "text": "{source} 말이, {actor:이} 통 안 보인다더구먼." },
    { "id": "absent.rumor", "text": "{actor:이} 안 보인다는 말이 돌더구먼." },

    { "id": "answer.none", "text": "글쎄, 별다른 건 못 봤소." },
    { "id": "answer.none", "text": "딱히 이상한 건 없었소." },
    { "id": "death.seen", "text": "{actor:이} 죽어 나갔다지 뭐요. 아이고, 불쌍해라…" },
    { "id": "death.heard", "text": "{source} 말이, {actor:이} 죽었다더구먼." },
    { "id": "death.rumor", "text": "{actor:이} 죽었다는 말이 돌더구먼." },

    { "id": "rumor.none", "text": "요즘은 별 소문 없소." },
    { "id": "alibi.work", "text": "{when} {area}에서 {work:을} 했소." },
    { "id": "alibi.rest", "text": "{when} {area}에서 좀 쉬었소." },
    { "id": "alibi.with", "text": "{names}도 거기 있었지." },
    { "id": "alibi.alone", "text": "거기선 아무도 못 봤소." },
    { "id": "today.none", "text": "그냥 이것저것 했소." },

    { "id": "tool.held", "text": "{holder:이} {tool:을} 들고 있더구먼." },
    { "id": "tool.place", "text": "{area} 쪽에 {tool:이} 놓여 있더구먼." },
    { "id": "tool.near", "text": "저짝에 {tool:이} 떨어져 있던디." },
    { "id": "tool.none", "text": "{tool}? 못 봤는디유." },

    { "id": "trace.ask.none", "text": "그건 잘 모르겠소." },

    { "id": "panic.body", "text": "으, 으악! 사, 사람이 죽었어!" },
    { "id": "panic.body", "text": "아이고 맙소사! 이게 무슨 일이여!" },
    { "id": "panic.body", "text": "히익…! 귀, 귀신이 왔다 갔어!" },

    { "id": "item.startled.Salt", "text": "에퉤퉤, 지금 뭘 뿌리는 거요?" },
    { "id": "item.startled.Salt", "text": "아니, 멀쩡한 사람한테 웬 소금이오?" },
    { "id": "item.startled.Salt", "text": "어허, 내가 무슨 부정이라도 탔단 말이오?" },
    { "id": "item.startled.BeanMugwort", "text": "아야! 웬 팥알이 날아오는 거요?" },
    { "id": "item.startled.BeanMugwort", "text": "이보시오, 사람한테 팥을 던지면 쓰나!" },
    { "id": "item.startled.BeanMugwort", "text": "어이쿠, 쑥 냄새… 이게 다 뭐요?" },
    { "id": "item.startled.Bell", "text": "아이고, 방울 소리에 귀가 다 먹먹하구먼." },
    { "id": "item.startled.Bell", "text": "무슨 굿이라도 하시오? 깜짝 놀랐소." },
    { "id": "item.startled.Gong", "text": "아이고 귀야! 징은 왜 치시오?" },
    { "id": "item.startled.Gong", "text": "어이쿠, 간 떨어질 뻔했소!" },

    { "id": "feeling.fine", "text": "늘 똑같소. 별 탈 없이 지내오." },
    { "id": "feeling.fine", "text": "그럭저럭 괜찮소. 밥도 잘 넘어가고." },
    { "id": "feeling.uneasy", "text": "요즘 잠자리가 좀 뒤숭숭하구먼." },
    { "id": "feeling.uneasy", "text": "괜히 마음이 싱숭생숭하오. 별일이야 없겠지만." },
    { "id": "feeling.anxious", "text": "요즘 통 머리가 어지럽고 가슴이 답답하오." },
    { "id": "feeling.anxious", "text": "밤마다 식은땀이 나서 잠을 못 이루겠소." },
    { "id": "feeling.breaking", "text": "오늘따라 온몸에 기운이 하나도 없소… 무슨 일이 날 것만 같소." },
    { "id": "feeling.breaking", "text": "누가 자꾸 날 부르는 것 같소… 이러다 큰일 나겠소." },

    { "id": "exorcised.thanks", "text": "내 몸에 붙은 귀신을 쫓아내 주었다지요? 정말 고맙소!" },
    { "id": "exorcised.thanks", "text": "이제야 정신이 맑아졌소. 이 은혜를 어찌 갚을꼬." },
    { "id": "exorcised.thanks", "text": "그동안 내가 무슨 짓을 했는지 기억도 안 나오… 살려 줘서 고맙소." },

    { "id": "bump", "text": "어이쿠! 눈 좀 뜨고 다니시오." },
    { "id": "bump", "text": "아이고, 사람 치겠소!" },
    { "id": "bump", "text": "어허, 조심하시오." },
    { "id": "bump", "text": "뭐가 그리 급하오?" },
    { "id": "bye", "text": "살펴 가시오." },
    { "id": "bye.home", "text": "이만 자 봐야겠소. 살펴 가시오." },
    { "id": "bye.home", "text": "밤이 깊었구먼. 나도 이만 눈 좀 붙여야겠소." },
    { "id": "bye.home", "text": "내일 또 봅시다. 이만 들어가 자야겠소." },

    { "id": "smalltalk.rest", "text": "오늘 날이 덥구먼." },
    { "id": "smalltalk.rest", "text": "요즘 밤마다 뒤숭숭하오." },
    { "id": "smalltalk.rest", "text": "올해 농사는 어떨지 모르겠소." },
    { "id": "smalltalk.rest", "text": "주막 막걸리가 그립구먼." },
    { "id": "smalltalk.work", "text": "허리가 끊어지겄네." },
    { "id": "smalltalk.work", "text": "이거 오늘 안에 끝내야 하는디." },
    { "id": "smalltalk.work", "text": "손 좀 빨리 놀리게." },

    { "id": "ask.anomaly", "text": "요즘 이상한 걸 본 적 없소?" },
    { "id": "ask.anomaly.next", "text": "다른 건 또 본 거 없소?" },
    { "id": "ask.rumor", "text": "도는 소문 있소?" },
    { "id": "ask.today", "text": "오늘 뭐 했소?" },
    { "id": "ask.today.next", "text": "그다음엔 뭐 했소?" },
    { "id": "ask.feeling", "text": "요즘 몸은 좀 어떻소?" },
    { "id": "ask.tool", "text": "{tool:을} 본 적 있소?" },
    { "id": "ask.trace", "text": "{area}의 {object}에 대해 아는 게 있소?" },
    { "id": "ask.bye", "text": "그만 가 보겠소." }
  ],
  "verbs": [
    { "id": "tremble", "text": "부들부들 떠는" },
    { "id": "stare_void", "text": "허공을 멍하니 쳐다보는" },
    { "id": "talk_nonsense", "text": "혼자 알 수 없는 소리를 중얼거리는" },
    { "id": "walk_grotesque", "text": "괴상하게 몸을 꺾으며 걷는" },
    { "id": "neck_twist", "text": "목을 기괴하게 꺾는" },
    { "id": "waist_bend", "text": "허리를 접듯이 꺾는" },
    { "id": "no_shadow", "text": "그림자가 없는" },
    { "id": "pale_skin", "text": "낯빛이 송장처럼 창백해지는" },
    { "id": "black_eyes", "text": "눈이 새까맣게 변하는" },
    { "id": "empty_hand_work", "text": "빈손으로 연장질을 하는" },
    { "id": "work_wrong_tool", "text": "{object:으로} 일을 하는" },
    { "id": "work_wrong_action", "text": "하던 일과 딴판인 짓을 하는" },
    { "id": "work_wrong_place", "text": "제 일터도 아닌 데서 일을 하는" },
    { "id": "stand_still", "text": "넋 나간 듯 한참을 서 있는" }
  ],
