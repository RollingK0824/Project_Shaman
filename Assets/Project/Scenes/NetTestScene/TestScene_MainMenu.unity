    - target: {fileID: 2731259435737032746, guid: 54a501146cc701c4090f43bea7d0bc0e, type: 3}
      propertyPath: m_text
      value: "<size=72><b>Project Shaman</b></size>\r\n\r\n\r\n\r\n<size=44><b>\uAC1C\uBC1C</b></size>\r\n\r\n<size=32>\uB124\uD2B8\uC6CC\uD06C</size>\r\n\uC774\uC2B9\uD638\r\n\r\n<size=32>\uC2DC\uC2A4\uD15C</size>\r\n\uAC15\uC800\uC2A4\uD2F4\uC131\uC8FC\r\n\r\n<size=32>\uD50C\uB808\uC774\uC5B4</size>\r\n\uC6A9\uB2E4\uC778\r\n\r\n<size=32>NPC\u318DAI</size>\r\n\uAE40\uB300\uD6C8\r\n\r\n\r\n\r\n<size=48><b>\uB9F5</b></size>\r\n\r\n\r\n<size=34>\uC21C\uCC9C
        \uB099\uC548\uC74D\uC131 3D \uC5D0\uC14B</size>\r\n\u3131\uC790\uC9D1, \uC11C\uBB38
        \uC606\uC9D1, \uC774\uBC29\uC9D1, \uD207\uB9C8\uB8E8\uC9D1, \uB4E4\uCC3D\uC9D1
        \uC678 \uAD6C\uC870\uBB3C \uBC0F \uC18C\uD488\r\n\uC81C\uACF5: \uAD6D\uAC00\uC720\uC0B0\uCCAD
        \xB7 \uAD6D\uAC00\uC720\uC0B0 \uB514\uC9C0\uD138 \uC11C\uBE44\uC2A4\r\n<size=26>\uACF5\uACF5\uB204\uB9AC
        \uC81C1\uC720\uD615 (\uCD9C\uCC98\uD45C\uC2DC)</size>\r\n\r\n<size=34>\uD658\uACBD</size>\r\nCoastal
        Dune Pack\r\nAllSky\r\nSimple Water Shader (IgniteCoders)\r\nWeel\r\n\r\n<size=34>AI
        \uC0DD\uC131 \uBAA8\uB378</size>\r\nTripo AI\r\n<size=26>\uD480 \xB7 \uC2DD\uBB3C
        \xB7 \uC6B8\uD0C0\uB9AC \xB7 \uAC8C\uC2DC\uD310 \xB7 \uD1A0\uD15C \xB7 \uAC04\uD310
        \xB7 \uBD09\uC778 \uD56D\uC544\uB9AC</size>\r\n\r\n\r\n\r\n\r\n\r\n<size=48><b>\uCE90\uB9AD\uD130</b></size>\r\n\r\n\r\n<size=34>\uBAA8\uB378</size>\r\n\u3010\uD50C\uB808\uC774\uC5B4
        / NPC / \uADC0\uC2E0 \uBAA8\uB378 \uCD9C\uCC98\u3011\r\nJoseon Royal Wear\r\n\r\n<size=34>\uC560\uB2C8\uBA54\uC774\uC158</size>\r\nKevin
        Iglesias - Human Animations\r\nMixamo (Adobe)\r\nUnity Starter Assets\r\n\r\n\r\n\r\n\r\n\r\n<size=48><b>\uC544\uC774\uD15C</b></size>\r\n\r\n\r\n<size=34>\uBAA8\uB378</size>\r\nTripo
        AI\r\n<size=26>\uBC29\uC6B8 \xB7 \uC9D5 \xB7 \uC18C\uAE08 \xB7 \uD325\uC465
        \xB7 \uC5FD\uC804 \xB7 \uCD08\uD63C\uACBD \xB7 \uCD08\uB871\uBD88 \xB7 \uBD80\uC801
        \xB7 \uC218\uCCA9 \xB7 \uC7AC\uB8CC</size>\r\n\u3010\uD5A5\uB85C \xB7 \uBC29\uC6B8
        \uBAA8\uB378 \uCD9C\uCC98\u3011\r\n\r\n<size=34>\uC774\uD399\uD2B8</size>\r\nDistortion
        Shockwaves\r\nMagic Effects Free\r\n\r\n\r\n\r\n\r\n\r\n<size=48><b>\uC0AC\uC6B4\uB4DC</b></size>\r\n\r\n\r\nGamemaster
        Audio - Pro Sound Collection\r\nUniversal Sound FX\r\nInterface and Item
        Sounds\r\nSurvival Game Sounds\r\nUnity Starter Assets\r\nOpenGameArt <size=26>(CC0)</size>\r\n\r\n\r\n\r\n\r\n\r\n<size=48><b>UI</b></size>\r\n\r\n\r\n<size=34>\uD3F0\uD2B8</size>\r\n\uC870\uC120100\uB144\uCCB4
        (ChosunCentennial)\r\n\r\n<size=34>\uC774\uBBF8\uC9C0</size>\r\n\u3010UI
        \uC774\uBBF8\uC9C0 \uCD9C\uCC98 \uB610\uB294 \uC774 \uD56D\uBAA9 \uC0AD\uC81C\u3011\r\n\r\n\r\n\r\n\r\n\r\n<size=48><b>\uAE30\uC220</b></size>\r\n\r\n\r\nUnity\r\nMirror\r\nSteamworks.NET\r\n\r\n\r\n\r\n\r\n\r\n<size=40><b>\uB77C\uC774\uC120\uC2A4</b></size>\r\n\r\n<size=24>\uBCF8
        \uC800\uC791\uBB3C\uC740 '\uAD6D\uAC00\uC720\uC0B0\uCCAD'\uC5D0\uC11C '2023\uB144'
        \uC791\uC131\uD558\uC5EC \uACF5\uACF5\uB204\uB9AC \uC81C1\uC720\uD615\uC73C\uB85C
        \uAC1C\uBC29\uD55C\r\n'\uC21C\uCC9C \uB099\uC548\uC74D\uC131 3D \uC5D0\uC14B(\uC791\uC131\uC790:
        \uAD6D\uAC00\uC720\uC0B0\uCCAD)'\uC744 \uC774\uC6A9\uD558\uC600\uC73C\uBA70,\r\n\uD574\uB2F9
        \uC800\uC791\uBB3C\uC740 '\uAD6D\uAC00\uC720\uC0B0\uCCAD \uAD6D\uAC00\uC720\uC0B0
        \uB514\uC9C0\uD138 \uC11C\uBE44\uC2A4, \u3010\uC0AC\uC774\uD2B8 \uC8FC\uC18C\u3011'\uC5D0\uC11C\r\n\uBB34\uB8CC\uB85C
        \uB2E4\uC6B4\uBC1B\uC73C\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\nMirror
